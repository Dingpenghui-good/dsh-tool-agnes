{
    "name":  "@dingpenghui/agnes",
    "version":  "1.6.2",
    "description":  "Agnes AI media-generation bundle: one toggle mounts the four tools generate_image / generate_video / get_video_task / generate_img2vid (three component packages)",
    "keywords":  [
                     "deepseek",
                     "harness",
                     "dsh",
                     "cordis-bundle",
                     "cordis-plugin",
                     "agnes",
                     "image-generation",
                     "video-generation",
                     "text-to-image",
                     "text-to-video",
                     "image-to-video"
                 ],
    "type":  "module",
    "main":  "./lib/index.js",
    "exports":  {
                    ".":  {
                              "types":  "./lib/index.d.ts",
                              "default":  "./lib/index.js"
                          },
                    "./cordis.patch.yml":  "./cordis.patch.yml",
                    "./package.json":  "./package.json"
                },
    "files":  [
                  "lib",
                  "cordis.patch.yml",
                  "package.json"
              ],
    "dsh":  {
                 "bundle":  {
                                "patch":  "./cordis.patch.yml"
                            }
             },
    "dependencies":  {
                         "@dingpenghui/agnes-image":  "^1.6.1",
                         "@dingpenghui/agnes-video":  "^1.6.1",
                         "@dingpenghui/agnes-img2vid":  "^1.6.1"
                     },
    "peerDependencies":  {
                              "@deepseek-ai/cordis":  "^4.0.2"
                          },
    "license":  "MIT",
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/Dingpenghui-good/dsh-tool-agnes.git"
                   }
}
